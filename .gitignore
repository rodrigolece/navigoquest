# Analysis data and outputs (generated by the notebooks; not distributed,
# except the environment files and the small raw-path files below)
# NB: leading slash anchors these to the repo root, so they do NOT match
# src/navigoquest/data/ (the packaged level files).
/data/*
!/data/env_boundary/
!/data/env_cohort/
# raw paths: only the small files are distributed; the large level CSVs are downloaded separately
!/data/raw_paths/
/data/raw_paths/*
!/data/raw_paths/clinical_paths.feather
!/data/raw_paths/users_gb_1998.csv
/figures/
/statistical_tests/

